# Satır sonu politikası
#
# Windows betikleri CRLF olmalı; LF ile .bat dosyalarındaki
# `if errorlevel (` blokları bozulabilir.
* text=auto eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.spec    text eol=crlf
.gitignore text eol=lf

# İkililer
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.gif     binary
*.exe     binary
*.dll     binary
*.bin     binary
*.mp4     binary
*.mkv     binary
*.wav     binary
*.zip     binary
